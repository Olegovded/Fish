# Скопируйте этот файл в .env и заполните значения.

# Токен бота от @BotFather (обязательно).
BOT_TOKEN=

# Имя бота без @ — для водяного знака и deep-link карточек шеринга.
BOT_USERNAME=my_fishing_bot

# Путь к файлу базы SQLite (по умолчанию fishing.db в корне проекта).
DB_PATH=fishing.db

# Размер ячейки сетки в метрах. Локация всегда округляется до центра ячейки.
GRID_SIZE_M=1000

# Публичный HTTPS-URL мини-приложения (карта). Оставьте пустым, если пока не
# разворачиваете WebApp — тогда кнопка «Карта» не показывается, а дневник
# отдаётся списком в чате. Для WebApp Telegram требует именно https.
WEBAPP_URL=

# Хост/порт локального веб-сервера мини-приложения.
WEB_HOST=0.0.0.0
WEB_PORT=8080
