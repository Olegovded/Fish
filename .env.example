# Скопируйте этот файл в .env и заполните значения.

# Токен бота от @BotFather (обязательно).
BOT_TOKEN=

# Имя бота без @ — для ссылок шеринга и приглашений.
BOT_USERNAME=Ribaku_bot

# Постоянная база (Postgres/Supabase). Если задана — используется она.
# Пример: postgresql://postgres:ПАРОЛЬ@db.xxxx.supabase.co:5432/postgres
DATABASE_URL=

# Локальная база SQLite (используется, если DATABASE_URL пуст).
DB_PATH=fishing.db

# Размер ячейки сетки в метрах. Локация всегда округляется до центра ячейки.
GRID_SIZE_M=1000

# Публичный HTTPS-URL мини-приложения. На Render подставляется сам
# (RENDER_EXTERNAL_URL); на других хостингах укажите вручную.
WEBAPP_URL=

# Хост/порт локального веб-сервера. На хостинге порт берётся из $PORT.
WEB_HOST=0.0.0.0
WEB_PORT=8080
